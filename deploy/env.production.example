# HABI — production .env template (Laravel API, single-domain VPS)
# Copy to backend/.env, fill secrets, then: php artisan key:generate
# NEVER commit the real .env. Do NOT use ';' inline comments in .env —
# the parser rejects them; put a '#' line above instead.

APP_NAME=HABI
APP_ENV=production
# leave blank, then run: php artisan key:generate
APP_KEY=
# live domain also forces debug off in config/app.php
APP_DEBUG=false
APP_URL=https://becoolbox.app

LOG_LEVEL=warning

# --- PostgreSQL (NOT mysql) ---
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=habi
DB_USERNAME=habi
DB_PASSWORD=CHANGE_ME_strong_unique

# --- Redis (cache + distance cache + session + queue) ---
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=null
SESSION_DRIVER=redis
DISTANCE_CACHE_ENABLED=true
DISTANCE_CACHE_STORE=redis
QUEUE_CONNECTION=redis

# --- Sanctum: API uses Bearer tokens; keep stateful domains to the live app ---
SANCTUM_STATEFUL_DOMAINS=becoolbox.app,www.becoolbox.app

# Driving distance: without a key the app falls back to public OSRM (no
# geometry) and haversine — fees still work, accuracy lower.
DISTANCE_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
ORS_API_KEY=

# --- Delivery economics ---
PLATFORM_SPLIT_PERCENT=15.00
RIDER_SPLIT_PERCENT=85.00
NIGHT_SURGE_ENABLED=true
NIGHT_SURGE_MULTIPLIER=1.40
WEATHER_SURGE_ENABLED=true
WEATHER_SURGE_MULTIPLIER=1.30
ETA_BUFFER_MULTIPLIER=1.30
REFERRAL_MICRO_COMMISSION=3.00

# Affiliate poster links + QR redirect bases
POSTER_BASE_URL=https://becoolbox.app
FRONTEND_URL=https://becoolbox.app

# SMS (currently UNWIRED: forgot-password OTP only writes to storage/logs).
# Wire a provider before going live if OTP codes must reach riders.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=HABI
