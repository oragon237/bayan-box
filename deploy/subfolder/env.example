# HABI subfolder deploy (www.clientwebsitedemo.com/habi) — shared/DirectAdmin-style host
# Copy to /home/rao1983/habi-backend/.env, fill every value, then:
#   php artisan key:generate
# (Never use ';' as an inline comment in .env — Laravel's parser rejects it.
#  Use a '#' line above instead.)

APP_NAME=HABI
APP_ENV=production
# Leave blank, then run: php artisan key:generate
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.clientwebsitedemo.com/habi

LOG_LEVEL=warning

# --- PostgreSQL — REQUIRED. This app uses PG syntax (ilike); MySQL will NOT work. ---
# Create it in the hosting control panel and paste the credentials here.
DB_CONNECTION=pgsql
DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=habi
DB_USERNAME=habi
DB_PASSWORD=

# --- No Redis assumed on shared hosting: file/sync drivers everywhere ---
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync
DISTANCE_CACHE_ENABLED=true
DISTANCE_CACHE_STORE=file

SANCTUM_STATEFUL_DOMAINS=www.clientwebsitedemo.com

# Driving distance: without these the app fails over to public OSRM (no polyline)
# and straight-line haversine — fees still work. Get a free Mapbox token for real routes.
DISTANCE_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
ORS_API_KEY=

PLATFORM_SPLIT_PERCENT=15.00
RIDER_SPLIT_PERCENT=85.00
NIGHT_SURGE_ENABLED=false
NIGHT_SURGE_MULTIPLIER=1.40
WEATHER_SURGE_ENABLED=false
WEATHER_SURGE_MULTIPLIER=1.30
ETA_BUFFER_MULTIPLIER=1.30
REFERRAL_MICRO_COMMISSION=3.00

# Base URL the SPA uses in-app for share links (config 'affiliate.poster_base_url')
POSTER_BASE_URL=https://www.clientwebsitedemo.com/habi

# Where an affiliate QR scan (/habi/api/r/{code}) REDIRECTS the customer's phone.
# Must point at the live app root — the backend default is http://localhost:3000,
# which is unreachable on a visitor's phone.
FRONTEND_URL=https://www.clientwebsitedemo.com/habi

# SMS gateway still unwired (forgot-password OTP goes to storage/logs only).
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=HABI
