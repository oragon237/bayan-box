APP_NAME=BayanBox
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_LEVEL=debug

# ── Neon PostgreSQL (provider: Neon, SSL required) ─────────────────────────
DB_CONNECTION=pgsql
DB_HOST=ep-wispy-feather-azxs34ep-pooler.c-3.ap-southeast-1.aws.neon.tech
DB_PORT=5432
DB_DATABASE=neondb
DB_USERNAME=neondb_owner
DB_PASSWORD=REPLACE_WITH_NEON_PASSWORD
DB_SSLMODE=require

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

DISTANCE_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
ORS_API_KEY=

DISTANCE_CACHE_ENABLED=true
DISTANCE_CACHE_STORE=database

PLATFORM_SPLIT_PERCENT=15.00
RIDER_SPLIT_PERCENT=85.00

NIGHT_SURGE_ENABLED=true
NIGHT_SURGE_MULTIPLIER=1.50
WEATHER_SURGE_ENABLED=false
WEATHER_SURGE_MULTIPLIER=1.50

ETA_BUFFER_MULTIPLIER=1.30

SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=BayanBox

REFERRAL_MICRO_COMMISSION=2.00
POSTER_BASE_URL=http://localhost:3000

SANCTUM_STATEFUL_DOMAINS=localhost
SESSION_DRIVER=database