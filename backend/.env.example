APP_NAME=Bayan
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=bayanbox
DB_USERNAME=postgres
DB_PASSWORD=

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

DISTANCE_PROVIDER=mapbox
MAPBOX_ACCESS_TOKEN=
ORS_API_KEY=

DISTANCE_CACHE_ENABLED=true
DISTANCE_CACHE_STORE=redis

PLATFORM_SPLIT_PERCENT=15.00
RIDER_SPLIT_PERCENT=85.00

NIGHT_SURGE_ENABLED=true
NIGHT_SURGE_MULTIPLIER=1.50
WEATHER_SURGE_ENABLED=false
WEATHER_SURGE_MULTIPLIER=1.50

ETA_BUFFER_MULTIPLIER=1.30

SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=Bayan

REFERRAL_MICRO_COMMISSION=2.00
POSTER_BASE_URL=http://localhost:8000

SANCTUM_STATEFUL_DOMAINS=localhost
SESSION_DRIVER=redis